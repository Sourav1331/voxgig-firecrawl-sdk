# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 10
  metrics: count: path: 16
  metrics: count: method: 18

  entity: batch_scrape_status_response_obj: {
    path: "/batch/scrape": {
      op: create: method: *POST
    }
    path: "/batch/scrape/{id}": {
      op: load: method: *GET
    }
  }

  entity: billing: {
    path: "/team/credit-usage": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/team/credit-usage/historical": {
      op: list: method: *GET
      op: list: transform: res: *("`body.periods`")|top
    }
    path: "/team/token-usage": {
      op: load: method: *GET
      op: load: transform: res: *("`body.data`")|top
    }
    path: "/team/token-usage/historical": {
      op: list: method: *GET
      op: list: transform: res: *("`body.periods`")|top
    }
  }

  entity: crawl: {
    path: "/crawl": {
      op: create: method: *POST
    }
    path: "/crawl/{id}": {
      op: load: method: *GET
      op: remove: method: *DELETE
    }
  }

  entity: crawl_errors_response_obj: {
    path: "/batch/scrape/{id}/errors": {
      rename: param: "id": *"scrape_id"
      op: list: method: *GET
    }
    path: "/crawl/{id}/errors": {
      action: "errors": {}
      op: list: method: *GET
    }
  }

  entity: crawling: {
    path: "/crawl/active": {
      op: list: method: *GET
      op: list: transform: res: *("`body.crawls`")|top
    }
  }

  entity: extract: {
    path: "/extract": {
      op: create: method: *POST
    }
    path: "/extract/{id}": {
      op: load: method: *GET
    }
  }

  entity: map: {
    path: "/map": {
      op: create: method: *POST
    }
  }

  entity: scrape: {
    path: "/scrape": {
      op: create: method: *POST
      op: create: transform: res: *("`body.data`")|top
    }
  }

  entity: scraping: {
    path: "/batch/scrape/{id}": {
      op: remove: method: *DELETE
    }
  }

  entity: search: {
    path: "/search": {
      op: create: method: *POST
    }
  }

}