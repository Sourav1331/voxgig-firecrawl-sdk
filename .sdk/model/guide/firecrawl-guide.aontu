# Guide entry file: put customizations below the includes. The base guide
# it includes is generated and overwritten on every build.
@"@voxgig/apidef/model/guide.aontu"
@"./firecrawl-base-guide.aontu"

# Keep the standalone CLI guide consistent with the SDK build guide.
guide: entity: crawl_errors_response_obj: path: {
  "/crawl/{id}/errors": op: list: transform: res: "`body.errors`"
  "/batch/scrape/{id}/errors": op: list: transform: res: "`body.errors`"
}
